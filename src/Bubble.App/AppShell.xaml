<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Bubble.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Bubble.App.Pages"
    Shell.FlyoutBehavior="Disabled"
    Title="Bubble">

    <TabBar>
        <ShellContent Title="Today" Icon="ic_home.png" Route="home" ContentTemplate="{DataTemplate pages:HomePage}" />
        <ShellContent Title="Bubbles" Icon="ic_bubbles.png" Route="bubbles" ContentTemplate="{DataTemplate pages:BubblesPage}" />
        <ShellContent Title="Profile" Icon="ic_user.png" Route="profile" ContentTemplate="{DataTemplate pages:ProfilePage}" />
    </TabBar>

</Shell>
