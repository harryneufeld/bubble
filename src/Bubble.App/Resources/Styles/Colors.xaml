<?xml version="1.0" encoding="UTF-8" ?>
<!-- Farb-Token aus DESIGN.md: dunkel, lebendig, Schillern einer Seifenblase. Android: siehe auch Platforms/Android/Resources/values/colors.xml -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Flächen -->
    <Color x:Key="Canvas">#0B0A10</Color>
    <Color x:Key="Surface">#17151F</Color>
    <Color x:Key="SurfaceRaised">#221F2C</Color>
    <Color x:Key="Hairline">#2E2A3A</Color>
    <Color x:Key="Scrim">#99000000</Color>
    <Color x:Key="Glass">#8C0B0A10</Color>

    <!-- Text -->
    <Color x:Key="Ink">#F5F3FA</Color>
    <Color x:Key="InkSoft">#C9C4D6</Color>
    <Color x:Key="Muted">#8F89A0</Color>

    <!-- Schillern: Pink → Violett → Cyan -->
    <Color x:Key="Pink">#FF4F9A</Color>
    <Color x:Key="Violet">#8B5CF6</Color>
    <Color x:Key="Cyan">#22D3EE</Color>
    <!-- dunklere Stufen für Flächen mit weißem Text (>= 4,5:1) -->
    <Color x:Key="CtaStart">#D9246F</Color>
    <Color x:Key="CtaEnd">#6D3CF5</Color>
    <Color x:Key="OnCta">#FFFFFF</Color>
    <Color x:Key="Accent">#B9A2FF</Color>

    <!-- Stimmung des Tages -->
    <Color x:Key="Top">#3A2D0E</Color>
    <Color x:Key="OnTop">#FFD27A</Color>
    <Color x:Key="Flop">#14283A</Color>
    <Color x:Key="OnFlop">#9CC7FF</Color>

    <!-- Semantik -->
    <Color x:Key="Error">#FF5A6E</Color>
    <Color x:Key="Success">#4ADE80</Color>

    <!-- Verläufe -->
    <LinearGradientBrush x:Key="BubbleGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Pink}" Offset="0" />
        <GradientStop Color="{StaticResource Violet}" Offset="0.55" />
        <GradientStop Color="{StaticResource Cyan}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CtaGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource CtaStart}" Offset="0" />
        <GradientStop Color="{StaticResource CtaEnd}" Offset="1" />
    </LinearGradientBrush>

    <!-- Dunkler Verlauf unten auf Fotos, damit weißer Text lesbar bleibt -->
    <LinearGradientBrush x:Key="PhotoShade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#000B0A10" Offset="0.35" />
        <GradientStop Color="#E60B0A10" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource Hairline}" />

</ResourceDictionary>
