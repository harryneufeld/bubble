<?xml version="1.0" encoding="UTF-8" ?>
<!-- Farb-Token aus DESIGN.md. Android: siehe auch Platforms/Android/Resources/values/colors.xml -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Aktion: genau eine pro Ansicht -->
    <Color x:Key="Primary">#5B47E0</Color>
    <Color x:Key="PrimaryPressed">#4935C4</Color>
    <Color x:Key="PrimaryDisabled">#CFC8F5</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>

    <!-- Flächen -->
    <Color x:Key="Canvas">#F7F1E8</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceSunk">#EFE7DA</Color>
    <Color x:Key="Hairline">#E1DACE</Color>

    <!-- Text -->
    <Color x:Key="Ink">#1C1B1A</Color>
    <Color x:Key="InkSoft">#4A4741</Color>
    <Color x:Key="Muted">#6B655C</Color>

    <!-- Stimmung des Tages (bewusst kein Rot/Grün) -->
    <Color x:Key="Top">#F3DFAE</Color>
    <Color x:Key="OnTop">#6B4A0B</Color>
    <Color x:Key="Flop">#DCE3EA</Color>
    <Color x:Key="OnFlop">#3C4F63</Color>

    <!-- Lebensdauer -->
    <Color x:Key="Story">#F1E3CF</Color>
    <Color x:Key="OnStory">#6B4A1E</Color>
    <Color x:Key="Persistent">#DDE3D3</Color>
    <Color x:Key="OnPersistent">#3F5235</Color>

    <!-- Semantik -->
    <Color x:Key="Error">#C2412D</Color>
    <Color x:Key="OnError">#FFFFFF</Color>
    <Color x:Key="Success">#3F6B45</Color>

    <!-- Dunkelmodus: warm statt blaugrau -->
    <Color x:Key="CanvasDark">#1A1816</Color>
    <Color x:Key="SurfaceDark">#24211E</Color>
    <Color x:Key="SurfaceSunkDark">#2E2A26</Color>
    <Color x:Key="HairlineDark">#3A3632</Color>
    <Color x:Key="InkDark">#F2ECE3</Color>
    <Color x:Key="InkSoftDark">#D6CFC4</Color>
    <Color x:Key="MutedDark">#ABA399</Color>
    <Color x:Key="PrimaryDark">#9C8FFF</Color>
    <Color x:Key="PrimaryPressedDark">#8A7BF5</Color>
    <Color x:Key="PrimaryDisabledDark">#3D3768</Color>
    <Color x:Key="OnPrimaryDark">#14112B</Color>

</ResourceDictionary>
