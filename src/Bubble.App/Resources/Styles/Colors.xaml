<?xml version="1.0" encoding="UTF-8" ?>
<!-- Farb-Token aus DESIGN.md: dunkel, lebendig, Schillern einer Seifenblase. Android: siehe auch Platforms/Android/Resources/values/colors.xml -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Surfaces -->
    <Color x:Key="Canvas">#0B0A10</Color>
    <Color x:Key="Surface">#17151F</Color>
    <Color x:Key="SurfaceRaised">#221F2C</Color>
    <Color x:Key="Hairline">#2E2A3A</Color>
    <Color x:Key="Scrim">#99000000</Color>
    <Color x:Key="Glass">#8C0B0A10</Color>

    <!-- Text -->
    <Color x:Key="Ink">#F5F3FA</Color>
    <Color x:Key="InkSoft">#C9C4D6</Color>
    <Color x:Key="Muted">#8F89A0</Color>

    <!-- One primary color: bubble violet. Pink and cyan only as small accents. -->
    <Color x:Key="Pink">#FF4F9A</Color>
    <Color x:Key="Violet">#8B5CF6</Color>
    <Color x:Key="Cyan">#22D3EE</Color>
    <!-- Primary: filled buttons and today's date, white text on it >= 4.5:1 -->
    <Color x:Key="Primary">#6D3CF5</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <!-- Lighter violet for text, links, selection and story rings on dark surfaces -->
    <Color x:Key="Accent">#B9A2FF</Color>

    <!-- Prints and polaroids -->
    <Color x:Key="Paper">#F3EEE3</Color>

    <!-- Semantik -->
    <Color x:Key="Error">#FF5A6E</Color>
    <Color x:Key="Success">#4ADE80</Color>

    <!-- Brushes: solid, no more shimmer gradients -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Violet}" />

    <!-- Dark gradient at the bottom of photos so white text stays readable -->
    <LinearGradientBrush x:Key="PhotoShade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#000B0A10" Offset="0.35" />
        <GradientStop Color="#E60B0A10" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource Hairline}" />

</ResourceDictionary>
