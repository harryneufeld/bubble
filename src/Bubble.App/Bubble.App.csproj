<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>Bubble.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<!-- SkiaSharp.Views.Maui 3.119.4 (the first build for .NET 10) needs at least MAUI 10.0.20 -->
		<MauiVersion>10.0.20</MauiVersion>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>Bubble</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>org.bubble.social</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.4.0</ApplicationDisplayVersion>
		<ApplicationVersion>8</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!-- Push: FCM settings of the Firebase project (see push.props). Without them the app is built without Firebase. -->
	<Import Project="push.props" Condition="Exists('push.props')" />
	<PropertyGroup Condition="'$(BubblePushFcmProjectId)' != '' And '$(BubblePushFcmAppId)' != '' And '$(BubblePushFcmApiKey)' != '' And '$(BubblePushFcmSenderId)' != '' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<BubbleFcm>true</BubbleFcm>
		<DefineConstants>$(DefineConstants);BUBBLE_FCM</DefineConstants>
	</PropertyGroup>
	<ItemGroup Condition="'$(BubbleFcm)' == 'true'">
		<!-- 124.x: newer versions need AndroidX versions that clash with the ones MAUI 10 brings -->
		<PackageReference Include="Xamarin.Firebase.Messaging" Version="124.1.2" />
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>Bubble.Fcm.ProjectId</_Parameter1>
			<_Parameter2>$(BubblePushFcmProjectId)</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>Bubble.Fcm.AppId</_Parameter1>
			<_Parameter2>$(BubblePushFcmAppId)</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>Bubble.Fcm.ApiKey</_Parameter1>
			<_Parameter2>$(BubblePushFcmApiKey)</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>Bubble.Fcm.SenderId</_Parameter1>
			<_Parameter2>$(BubblePushFcmSenderId)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

	<!-- Release-Signatur: Liegt außerhalb des Repos (Schlüssel und Passwort). Ohne diese Datei wird mit dem Debug-Schlüssel signiert. -->
	<Import Project="$([System.Environment]::GetFolderPath(SpecialFolder.UserProfile))\.bubble-signing\signing.props" Condition="'$(Configuration)' == 'Release' And Exists('$([System.Environment]::GetFolderPath(SpecialFolder.UserProfile))\.bubble-signing\signing.props')" />

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0B0A10" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0B0A10" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />
		<!-- The editor draws with SkiaSharp and needs the font files themselves -->
		<MauiAsset Include="Resources\Fonts\*" LogicalName="editorfonts\%(Filename)%(Extension)" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="QRCoder" Version="1.8.1" />
		<PackageReference Include="SkiaSharp" Version="3.119.4" />
		<PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="3.119.4" />
		<PackageReference Include="ZXing.Net.Maui.Controls" Version="0.10.4" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Bubble.Core\Bubble.Core.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
	</ItemGroup>

</Project>
