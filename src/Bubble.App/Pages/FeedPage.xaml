<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Bubble.App.Pages"
             x:Class="Bubble.App.Pages.FeedPage"
             x:DataType="pages:FeedPage">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Einladen" Clicked="OnInvite" />
    </ContentPage.ToolbarItems>

    <Grid Style="{StaticResource Column}" RowDefinitions="Auto,*,Auto" Padding="16,8,16,16">
        <Border Style="{StaticResource InfoBar}">
            <Grid ColumnDefinitions="*,Auto">
                <Label x:Name="LifetimeLabel" Style="{StaticResource SmallText}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Ändern" Clicked="OnChangeLifetime" Style="{StaticResource GhostButton}"
                        SemanticProperties.Hint="Lebensdauer für neue Posts ändern" />
            </Grid>
        </Border>

        <RefreshView Grid.Row="1" x:Name="Refresher" Refreshing="OnRefreshing" Margin="0,12">
            <CollectionView x:Name="Posts" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="8,48" Spacing="8" VerticalOptions="Center">
                        <Label Text="Heute noch kein Highlight." Style="{StaticResource TitleText}" HorizontalTextAlignment="Center" />
                        <Label Text="Wie war dein Tag? Mach gern den Anfang." Style="{StaticResource SoftText}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="pages:PostItem">
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding Author}" Style="{StaticResource HeadingText}" VerticalOptions="Center" />
                                    <Border Grid.Column="1" Style="{StaticResource ChipTop}" IsVisible="{Binding IsTop}">
                                        <Label Text="{Binding Mood}" Style="{StaticResource ChipTopText}" />
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource ChipFlop}" IsVisible="{Binding IsFlop}">
                                        <Label Text="{Binding Mood}" Style="{StaticResource ChipFlopText}" />
                                    </Border>
                                </Grid>
                                <Border Style="{StaticResource Photo}" IsVisible="{Binding HasImage}">
                                    <Image Source="{Binding Image}" Aspect="AspectFit" MaximumHeightRequest="480"
                                           SemanticProperties.Description="{Binding ImageDescription}" />
                                </Border>
                                <Label Text="{Binding Text}" IsVisible="{Binding HasText}" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Time}" Style="{StaticResource CaptionText}" VerticalOptions="Center" />
                                    <Border Grid.Column="1" Style="{StaticResource BadgeStory}" IsVisible="{Binding IsStory}">
                                        <Label Text="{Binding Remaining}" Style="{StaticResource BadgeStoryText}" />
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource BadgePersistent}" IsVisible="{Binding IsPersistent}">
                                        <Label Text="{Binding Remaining}" Style="{StaticResource BadgePersistentText}" />
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Button Grid.Row="2" x:Name="ComposeButton" Text="Mein Highlight teilen" Clicked="OnCompose" Style="{StaticResource PrimaryButton}" />
    </Grid>
</ContentPage>
