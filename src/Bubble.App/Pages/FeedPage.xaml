<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Bubble.App.Pages"
             x:Class="Bubble.App.Pages.FeedPage"
             x:DataType="pages:FeedPage">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Einladen" Clicked="OnInvite" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*,Auto" Padding="16,8">
        <Border Padding="12,8" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource Secondary}" StrokeThickness="0">
            <Grid ColumnDefinitions="*,Auto">
                <Label x:Name="LifetimeLabel" VerticalOptions="Center" TextColor="{StaticResource Tertiary}" />
                <Button Grid.Column="1" Text="Ändern" Clicked="OnChangeLifetime" Padding="12,4" FontSize="13" />
            </Grid>
        </Border>

        <RefreshView Grid.Row="1" x:Name="Refresher" Refreshing="OnRefreshing" Margin="0,8">
            <CollectionView x:Name="Posts">
                <CollectionView.EmptyView>
                    <Label Text="Heute noch keine Highlights. Mach den Anfang!" HorizontalTextAlignment="Center" Margin="24" />
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="pages:PostItem">
                        <Border Padding="14" StrokeShape="RoundRectangle 16" Stroke="{StaticResource Gray200}">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Author}" FontAttributes="Bold" />
                                    <Label Grid.Column="1" Text="{Binding Mood}" />
                                </Grid>
                                <Image Source="{Binding Image}" IsVisible="{Binding HasImage}" Aspect="AspectFit" MaximumHeightRequest="420" />
                                <Label Text="{Binding Text}" IsVisible="{Binding HasText}" FontSize="16" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Time}" FontSize="12" TextColor="{StaticResource Gray500}" />
                                    <Label Grid.Column="1" Text="{Binding Remaining}" FontSize="12" TextColor="{StaticResource Gray500}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Button Grid.Row="2" x:Name="ComposeButton" Text="✨ Mein Highlight teilen" Clicked="OnCompose" />
    </Grid>
</ContentPage>
