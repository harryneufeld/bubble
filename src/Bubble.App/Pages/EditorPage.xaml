<?xml version="1.0" encoding="utf-8" ?>
<!-- Design editor (DESIGN.md §10): canvas in the middle, calm floating toolbar below, the result is one flat JPEG -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="Bubble.App.Pages.EditorPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource Canvas}">
    <Grid>
        <Grid RowDefinitions="Auto,*,Auto" MaximumWidthRequest="720">
            <!-- Top bar: close, format, undo/redo, done -->
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8" Padding="12,10">
                <ImageButton Source="ic_close.png" Style="{StaticResource IconButton}" Clicked="OnClose"
                             SemanticProperties.Description="Close editor" />
                <HorizontalStackLayout x:Name="FormatToggle" Grid.Column="1" Spacing="6" HorizontalOptions="Center" VerticalOptions="Center" />
                <ImageButton x:Name="UndoButton" Grid.Column="2" Source="ic_undo.png" Style="{StaticResource IconButton}" Clicked="OnUndo"
                             SemanticProperties.Description="Undo" />
                <ImageButton x:Name="RedoButton" Grid.Column="3" Source="ic_redo.png" Style="{StaticResource IconButton}" Clicked="OnRedo"
                             SemanticProperties.Description="Redo" />
                <Button x:Name="DoneButton" Grid.Column="4" Text="Done" Clicked="OnDone" HeightRequest="44" Padding="20,0" />
            </Grid>

            <!-- Canvas, scaled to fit, never cropped -->
            <Grid x:Name="Stage" Grid.Row="1" Padding="16,4" SizeChanged="OnStageSizeChanged">
                <Border x:Name="CanvasFrame" StrokeThickness="0" HorizontalOptions="Center" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <skia:SKCanvasView x:Name="CanvasView" EnableTouchEvents="True" PaintSurface="OnPaintSurface" Touch="OnTouch"
                                       SemanticProperties.Description="Design canvas" />
                </Border>
                <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="{Binding IsRunning, Source={x:Reference Busy}}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>

            <!-- Floating toolbar: options of the open tool above, tools below -->
            <Border Grid.Row="2" BackgroundColor="{StaticResource SurfaceRaised}" StrokeThickness="0" Margin="12,8,12,12" Padding="8">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <ScrollView x:Name="OptionsScroller" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" IsVisible="False">
                        <HorizontalStackLayout x:Name="Options" Spacing="8" Padding="4,2" />
                    </ScrollView>
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout x:Name="Tools" Spacing="6" />
                    </ScrollView>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Text input over a dimmed canvas -->
        <Grid x:Name="TextOverlay" IsVisible="False" BackgroundColor="#D90B0A10" RowDefinitions="Auto,*" Padding="16,10">
            <Button Text="Done" Clicked="OnTextDone" HorizontalOptions="End" HeightRequest="44" Padding="20,0" />
            <Editor x:Name="TextInput" Grid.Row="1" VerticalOptions="Center" HorizontalTextAlignment="Center" AutoSize="TextChanges"
                    FontSize="34" TextColor="White" Placeholder="Type something" PlaceholderColor="{StaticResource Muted}"
                    MaxLength="300" BackgroundColor="Transparent" SemanticProperties.Description="Text on the design" />
        </Grid>
    </Grid>
</ContentPage>
