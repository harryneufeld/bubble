<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Bubble.App.Controls"
             x:Class="Bubble.App.Pages.ProfilePage"
             Shell.NavBarIsVisible="False"
             Title="Profile">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource Column}" Padding="20,24,20,32" Spacing="14">
            <controls:AvatarView x:Name="Avatar" Size="132" Ring="New" HorizontalOptions="Center" />
            <Label x:Name="NameLabel" Style="{StaticResource TitleText}" HorizontalTextAlignment="Center" />
            <Label x:Name="BioLabel" Style="{StaticResource SoftText}" HorizontalTextAlignment="Center" />
            <Label x:Name="StatsLabel" Style="{StaticResource CaptionText}" HorizontalTextAlignment="Center" />
            <Button Text="Edit profile" ImageSource="ic_edit.png" Clicked="OnEdit" Style="{StaticResource SecondaryButton}" HorizontalOptions="Center" Margin="0,4,0,12" />

            <Label Text="Account" Style="{StaticResource SectionText}" />
            <Border Style="{StaticResource Card}" Padding="4">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="14,14">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnBackup" /></Grid.GestureRecognizers>
                        <Image Source="ic_shield.png" WidthRequest="22" HeightRequest="22" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Backup and new device" Style="{StaticResource HeadingText}" FontSize="16" />
                            <Label x:Name="BackupLabel" Style="{StaticResource CaptionText}" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" Source="ic_chevron.png" WidthRequest="18" HeightRequest="18" Opacity="0.6" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" Margin="14,0" />
                    <Grid x:Name="NotificationsRow" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="14,10,14,10" IsVisible="False">
                        <Image Source="ic_bell.png" WidthRequest="22" HeightRequest="22" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Notifications" Style="{StaticResource HeadingText}" FontSize="16" />
                            <Label Text="Tells you when someone shares a highlight" Style="{StaticResource CaptionText}" />
                        </VerticalStackLayout>
                        <Switch x:Name="NotificationsSwitch" Grid.Column="2" Toggled="OnNotificationsToggled" VerticalOptions="Center"
                                SemanticProperties.Description="Notifications" />
                    </Grid>
                    <VerticalStackLayout x:Name="NotificationKindsList" Padding="50,0,14,8" Spacing="0" IsVisible="False">
                        <Grid ColumnDefinitions="*,Auto" Padding="0,2">
                            <Label Text="New highlights" Style="{StaticResource SoftText}" VerticalOptions="Center" />
                            <Switch x:Name="PostsSwitch" Grid.Column="1" Toggled="OnKindToggled" SemanticProperties.Description="Notify about new highlights" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Padding="0,2">
                            <Label Text="Hearts on your highlights" Style="{StaticResource SoftText}" VerticalOptions="Center" />
                            <Switch x:Name="HeartsSwitch" Grid.Column="1" Toggled="OnKindToggled" SemanticProperties.Description="Notify about hearts on your highlights" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Padding="0,2">
                            <Label Text="Comments on your highlights" Style="{StaticResource SoftText}" VerticalOptions="Center" />
                            <Switch x:Name="CommentsSwitch" Grid.Column="1" Toggled="OnKindToggled" SemanticProperties.Description="Notify about comments on your highlights" />
                        </Grid>
                    </VerticalStackLayout>
                    <BoxView x:Name="NotificationsDivider" Style="{StaticResource Divider}" Margin="14,0" IsVisible="False" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="14,14">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnServer" /></Grid.GestureRecognizers>
                        <Image Source="ic_server.png" WidthRequest="22" HeightRequest="22" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Server" Style="{StaticResource HeadingText}" FontSize="16" />
                            <Label x:Name="ServerLabel" Style="{StaticResource CaptionText}" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" Source="ic_chevron.png" WidthRequest="18" HeightRequest="18" Opacity="0.6" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" Margin="14,0" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" Padding="14,14"
                          SemanticProperties.Description="Log out" SemanticProperties.Hint="Removes the account from this device">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnLogOut" /></Grid.GestureRecognizers>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Log out" Style="{StaticResource HeadingText}" FontSize="16" TextColor="{StaticResource Error}" />
                            <Label Text="Removes the account from this device" Style="{StaticResource CaptionText}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="About Bubble" Style="{StaticResource SectionText}" Margin="0,12,0,0" />
            <Border Style="{StaticResource Card}" Padding="4">
                <VerticalStackLayout>
                    <VerticalStackLayout Padding="14,14,14,12" Spacing="2">
                        <Label Text="Bubble" Style="{StaticResource HeadingText}" FontSize="16" />
                        <Label x:Name="VersionLabel" Style="{StaticResource CaptionText}" />
                        <Label Text="© 2026 Harry Neufeld" Style="{StaticResource CaptionText}" TextColor="{StaticResource InkSoft}" />
                    </VerticalStackLayout>
                    <BoxView Style="{StaticResource Divider}" Margin="14,0" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="14,14"
                          SemanticProperties.Description="Bubble on GitHub" SemanticProperties.Hint="Opens the browser">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnGitHub" /></Grid.GestureRecognizers>
                        <Image Source="ic_link.png" WidthRequest="22" HeightRequest="22" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Source code on GitHub" Style="{StaticResource HeadingText}" FontSize="16" />
                            <Label Text="github.com/harryneufeld/bubble" Style="{StaticResource CaptionText}" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" Source="ic_chevron.png" WidthRequest="18" HeightRequest="18" Opacity="0.6" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" Margin="14,0" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="14,14"
                          SemanticProperties.Description="Harry Neufeld's website" SemanticProperties.Hint="Opens the browser">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnWebsite" /></Grid.GestureRecognizers>
                        <Image Source="ic_link.png" WidthRequest="22" HeightRequest="22" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Website" Style="{StaticResource HeadingText}" FontSize="16" />
                            <Label Text="harry-neufeld.de" Style="{StaticResource CaptionText}" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" Source="ic_chevron.png" WidthRequest="18" HeightRequest="18" Opacity="0.6" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Style="{StaticResource CaptionText}" Margin="4,12,4,0" HorizontalTextAlignment="Center"
                   Text="Bubble only stores encrypted data. Your key lives on this device – no account, no phone number." />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
