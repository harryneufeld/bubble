<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Bubble.App.Controls"
             x:Class="Bubble.App.Pages.ProfilePage"
             Shell.NavBarIsVisible="False"
             Title="Profile">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource Column}" Padding="20,24,20,32" Spacing="14">
            <controls:AvatarView x:Name="Avatar" Size="132" Ring="New" HorizontalOptions="Center" />
            <Label x:Name="NameLabel" Style="{StaticResource TitleText}" HorizontalTextAlignment="Center" />
            <Label x:Name="BioLabel" Style="{StaticResource SoftText}" HorizontalTextAlignment="Center" />
            <Label x:Name="StatsLabel" Style="{StaticResource CaptionText}" HorizontalTextAlignment="Center" />
            <Button Text="Edit profile" ImageSource="ic_edit.png" Clicked="OnEdit" Style="{StaticResource SecondaryButton}" HorizontalOptions="Center" Margin="0,4,0,12" />

            <Label Text="Home screen" Style="{StaticResource SectionText}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Border x:Name="ClassicOption" Style="{StaticResource Card}" Padding="10" StrokeShape="RoundRectangle 20">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnClassicMode" /></Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="10">
                        <Border BackgroundColor="{StaticResource Canvas}" StrokeShape="RoundRectangle 12" HeightRequest="132" Padding="10" InputTransparent="True">
                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="4">
                                    <Ellipse WidthRequest="34" HeightRequest="34" Fill="{StaticResource BubbleGradient}" />
                                    <Ellipse WidthRequest="24" HeightRequest="24" Fill="{StaticResource Violet}" VerticalOptions="End" />
                                    <Ellipse WidthRequest="16" HeightRequest="16" Fill="{StaticResource Cyan}" VerticalOptions="End" />
                                </HorizontalStackLayout>
                                <Border BackgroundColor="{StaticResource SurfaceRaised}" StrokeShape="RoundRectangle 8" HeightRequest="28" />
                                <Border BackgroundColor="{StaticResource SurfaceRaised}" StrokeShape="RoundRectangle 8" HeightRequest="18" />
                            </VerticalStackLayout>
                        </Border>
                        <Label Text="Classic" Style="{StaticResource HeadingText}" FontSize="15" />
                        <Label Text="Tidy summaries of what was kept" Style="{StaticResource CaptionText}" FontSize="12" TextColor="{StaticResource InkSoft}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" x:Name="BoxOption" Style="{StaticResource Card}" Padding="10" StrokeShape="RoundRectangle 20">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBoxMode" /></Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="10">
                        <Border BackgroundColor="{StaticResource Canvas}" StrokeShape="RoundRectangle 12" HeightRequest="132" InputTransparent="True">
                            <Grid>
                                <Ellipse WidthRequest="30" HeightRequest="30" Fill="{StaticResource BubbleGradient}" HorizontalOptions="Start" VerticalOptions="Start" Margin="10,8,0,0" />
                                <Ellipse WidthRequest="20" HeightRequest="20" Fill="{StaticResource Violet}" HorizontalOptions="Start" VerticalOptions="Start" Margin="46,14,0,0" />
                                <BoxView Color="{StaticResource Paper}" WidthRequest="44" HeightRequest="52" Rotation="-9" HorizontalOptions="Start" VerticalOptions="Start" Margin="8,48,0,0" />
                                <BoxView Color="{StaticResource Paper}" WidthRequest="44" HeightRequest="52" Rotation="7" HorizontalOptions="Start" VerticalOptions="Start" Margin="60,42,0,0" />
                                <BoxView Color="{StaticResource Paper}" WidthRequest="44" HeightRequest="52" Rotation="4" HorizontalOptions="Start" VerticalOptions="Start" Margin="30,88,0,0" />
                            </Grid>
                        </Border>
                        <Label Text="Box of memories" Style="{StaticResource HeadingText}" FontSize="15" />
                        <Label Text="Rummage through a pile of photos" Style="{StaticResource CaptionText}" FontSize="12" TextColor="{StaticResource InkSoft}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Label Text="Account" Style="{StaticResource SectionText}" Margin="0,12,0,0" />
            <Border Style="{StaticResource Card}" Padding="4">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="14,14">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnBackup" /></Grid.GestureRecognizers>
                        <Image Source="ic_shield.png" WidthRequest="22" HeightRequest="22" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Backup and new device" Style="{StaticResource HeadingText}" FontSize="16" />
                            <Label x:Name="BackupLabel" Style="{StaticResource CaptionText}" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" Source="ic_chevron.png" WidthRequest="18" HeightRequest="18" Opacity="0.6" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" Margin="14,0" />
                    <Grid x:Name="NotificationsRow" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="14,10,14,10" IsVisible="False">
                        <Image Source="ic_bell.png" WidthRequest="22" HeightRequest="22" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Notifications" Style="{StaticResource HeadingText}" FontSize="16" />
                            <Label Text="Tells you when someone shares a highlight" Style="{StaticResource CaptionText}" />
                        </VerticalStackLayout>
                        <Switch x:Name="NotificationsSwitch" Grid.Column="2" Toggled="OnNotificationsToggled" VerticalOptions="Center"
                                SemanticProperties.Description="Notifications" />
                    </Grid>
                    <VerticalStackLayout x:Name="NotificationKindsList" Padding="50,0,14,8" Spacing="0" IsVisible="False">
                        <Grid ColumnDefinitions="*,Auto" Padding="0,2">
                            <Label Text="New highlights" Style="{StaticResource SoftText}" VerticalOptions="Center" />
                            <Switch x:Name="PostsSwitch" Grid.Column="1" Toggled="OnKindToggled" SemanticProperties.Description="Notify about new highlights" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Padding="0,2">
                            <Label Text="Hearts on your highlights" Style="{StaticResource SoftText}" VerticalOptions="Center" />
                            <Switch x:Name="HeartsSwitch" Grid.Column="1" Toggled="OnKindToggled" SemanticProperties.Description="Notify about hearts on your highlights" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Padding="0,2">
                            <Label Text="Comments on your highlights" Style="{StaticResource SoftText}" VerticalOptions="Center" />
                            <Switch x:Name="CommentsSwitch" Grid.Column="1" Toggled="OnKindToggled" SemanticProperties.Description="Notify about comments on your highlights" />
                        </Grid>
                    </VerticalStackLayout>
                    <BoxView x:Name="NotificationsDivider" Style="{StaticResource Divider}" Margin="14,0" IsVisible="False" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="14,14">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnServer" /></Grid.GestureRecognizers>
                        <Image Source="ic_server.png" WidthRequest="22" HeightRequest="22" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Server" Style="{StaticResource HeadingText}" FontSize="16" />
                            <Label x:Name="ServerLabel" Style="{StaticResource CaptionText}" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" Source="ic_chevron.png" WidthRequest="18" HeightRequest="18" Opacity="0.6" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" Margin="14,0" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" Padding="14,14"
                          SemanticProperties.Description="Log out" SemanticProperties.Hint="Removes the account from this device">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnLogOut" /></Grid.GestureRecognizers>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Log out" Style="{StaticResource HeadingText}" FontSize="16" TextColor="{StaticResource Error}" />
                            <Label Text="Removes the account from this device" Style="{StaticResource CaptionText}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="More" Style="{StaticResource SectionText}" Margin="0,12,0,0" />
            <Border Style="{StaticResource Card}" Padding="4">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" Padding="14,14">
                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnAbout" /></Grid.GestureRecognizers>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="About this app" Style="{StaticResource HeadingText}" FontSize="16" />
                        <Label x:Name="VersionLabel" Style="{StaticResource CaptionText}" />
                    </VerticalStackLayout>
                    <Image Grid.Column="1" Source="ic_chevron.png" WidthRequest="18" HeightRequest="18" Opacity="0.6" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
