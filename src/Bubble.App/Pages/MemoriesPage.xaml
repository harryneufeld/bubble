<?xml version="1.0" encoding="utf-8" ?>
<!-- All highlights of a period as a grid -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Bubble.App.Controls"
             xmlns:pages="clr-namespace:Bubble.App.Pages"
             x:Class="Bubble.App.Pages.MemoriesPage"
             Shell.TabBarIsVisible="False">
    <CollectionView x:Name="Grid" SelectionMode="None" MaximumWidthRequest="600" Margin="9,4">
        <CollectionView.ItemsLayout>
            <GridItemsLayout Orientation="Vertical" Span="3" />
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="pages:PostItem">
                <controls:MemoryThumb Padding="3">
                    <controls:MemoryThumb.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMemoryTapped" CommandParameter="{Binding .}" />
                    </controls:MemoryThumb.GestureRecognizers>
                </controls:MemoryThumb>
            </DataTemplate>
        </CollectionView.ItemTemplate>
        <CollectionView.EmptyView>
            <Label Text="Nothing here yet." Style="{StaticResource SoftText}" HorizontalTextAlignment="Center" Margin="24,32" />
        </CollectionView.EmptyView>
    </CollectionView>
</ContentPage>
