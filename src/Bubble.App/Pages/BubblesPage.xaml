<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Bubble.App.Pages"
             x:Class="Bubble.App.Pages.BubblesPage"
             x:DataType="pages:BubblesPage"
             Title="Meine Bubbles">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Backup" Clicked="OnBackup" />
        <ToolbarItem Text="Server" Clicked="OnServer" />
    </ContentPage.ToolbarItems>

    <Grid Style="{StaticResource Column}" RowDefinitions="*,Auto" Padding="16,8,16,16">
        <CollectionView x:Name="List" SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="8,48" Spacing="8" VerticalOptions="Center">
                    <Label Text="Noch ganz still hier." Style="{StaticResource TitleText}" HorizontalTextAlignment="Center" />
                    <Label Style="{StaticResource SoftText}" HorizontalTextAlignment="Center"
                           Text="Gründe eine Bubble und lade deine Leute ein, oder tritt über einen Einladungslink bei." />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="pages:BubbleItem">
                    <Border Style="{StaticResource Card}" Padding="16,14"
                            SemanticProperties.Description="{Binding Name}" SemanticProperties.Hint="Öffnet die Bubble">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTapped" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Name}" Style="{StaticResource TitleText}" />
                            <HorizontalStackLayout Spacing="10">
                                <Border Style="{StaticResource BadgeStory}" IsVisible="{Binding IsStory}">
                                    <Label Text="{Binding Lifetime}" Style="{StaticResource BadgeStoryText}" />
                                </Border>
                                <Border Style="{StaticResource BadgePersistent}" IsVisible="{Binding IsPersistent}">
                                    <Label Text="{Binding Lifetime}" Style="{StaticResource BadgePersistentText}" />
                                </Border>
                                <Label Text="{Binding Server}" Style="{StaticResource CaptionText}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,12,0,0">
            <Button Text="Beitreten" Clicked="OnJoin" Style="{StaticResource SecondaryButton}" />
            <Button Grid.Column="1" Text="Neue Bubble" Clicked="OnCreate" Style="{StaticResource PrimaryButton}" />
        </Grid>
    </Grid>
</ContentPage>
