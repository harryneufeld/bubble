<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Bubble.App.Controls"
             xmlns:pages="clr-namespace:Bubble.App.Pages"
             x:Class="Bubble.App.Pages.BubblesPage"
             x:DataType="pages:BubblesPage"
             Shell.NavBarIsVisible="False"
             Title="Bubbles">
    <RefreshView x:Name="Refresher" Refreshing="OnRefreshing">
        <CollectionView x:Name="List" SelectionMode="None" MaximumWidthRequest="600">
            <CollectionView.Header>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="16,16,16,12">
                    <Label Text="Your bubbles" Style="{StaticResource TitleText}" VerticalOptions="Center" />
                    <ImageButton Grid.Column="1" Source="ic_scan.png" Style="{StaticResource IconButton}" Clicked="OnJoin"
                                 SemanticProperties.Description="Join bubble" ToolTipProperties.Text="Join bubble" />
                    <ImageButton Grid.Column="2" Source="ic_plus.png" Style="{StaticResource IconButton}" Clicked="OnCreate"
                                 Background="{StaticResource CtaGradient}"
                                 SemanticProperties.Description="Create bubble" ToolTipProperties.Text="Create bubble" />
                </Grid>
            </CollectionView.Header>
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="pages:BubbleTile">
                    <Border StrokeShape="RoundRectangle 24" HeightRequest="220" Margin="0" Background="{Binding Fallback}"
                            SemanticProperties.Description="{Binding Description}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTapped" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid>
                            <Image Source="{Binding Cover}" Aspect="AspectFill" IsVisible="{Binding HasCover}" />
                            <BoxView Background="{StaticResource PhotoShade}" />
                            <Ellipse WidthRequest="10" HeightRequest="10" Fill="{StaticResource BubbleGradient}" IsVisible="{Binding HasNew}"
                                     HorizontalOptions="End" VerticalOptions="Start" Margin="14" SemanticProperties.Description="New" />
                            <VerticalStackLayout VerticalOptions="End" Padding="14" Spacing="8">
                                <HorizontalStackLayout Spacing="-10" BindableLayout.ItemsSource="{Binding Faces}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="pages:Face">
                                            <Border StrokeShape="Ellipse" Stroke="{StaticResource Surface}" StrokeThickness="2">
                                                <controls:AvatarView Size="28" Image="{Binding Image}" Name="{Binding Name}" />
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                                <Label Text="{Binding Name}" FontFamily="BodyBold" FontSize="18" TextColor="White" LineBreakMode="TailTruncation" MaxLines="2" />
                                <Label Text="{Binding Meta}" FontSize="12" FontFamily="BodyMedium" TextColor="#D9FFFFFF" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24,48" Spacing="12">
                    <Label Text="No bubble yet" Style="{StaticResource TitleText}" HorizontalTextAlignment="Center" />
                    <Label Style="{StaticResource SoftText}" HorizontalTextAlignment="Center"
                           Text="Create a bubble for your people or scan the QR code of an invitation." />
                    <Button Text="Create bubble" Clicked="OnCreate" Margin="0,12,0,0" />
                    <Button Text="Join" Clicked="OnJoin" Style="{StaticResource SecondaryButton}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.Footer>
                <BoxView HeightRequest="24" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>
    </RefreshView>
</ContentPage>
