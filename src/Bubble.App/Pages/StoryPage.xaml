<?xml version="1.0" encoding="utf-8" ?>
<!-- Full-screen stories of a bubble: tap right = next, left = back -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Bubble.App.Controls"
             x:Class="Bubble.App.Pages.StoryPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Shell.PresentationMode="ModalAnimated"
             BackgroundColor="Black">
    <Grid MaximumWidthRequest="560">
        <!-- Inhalt -->
        <Grid x:Name="TextStage" IsVisible="False">
            <Label x:Name="StoryText" FontFamily="BodyBold" FontSize="32" LineHeight="1.15" TextColor="White"
                   HorizontalTextAlignment="Center" VerticalOptions="Center" Margin="32,0" />
        </Grid>
        <Image x:Name="StoryImage" Aspect="AspectFit" IsVisible="False" />

        <!-- Readability at top and bottom -->
        <BoxView HeightRequest="160" VerticalOptions="Start" InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#B3000000" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>
        <BoxView x:Name="BottomShade" HeightRequest="280" VerticalOptions="End" InputTransparent="True" Background="{StaticResource PhotoShade}" />

        <!-- Tippzonen -->
        <Grid ColumnDefinitions="*,2*">
            <BoxView Color="Transparent">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPrevious" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <BoxView Grid.Column="1" Color="Transparent">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNext" />
                </BoxView.GestureRecognizers>
            </BoxView>
        </Grid>

        <!-- Header: progress, sender, close -->
        <VerticalStackLayout VerticalOptions="Start" Padding="12,12,12,0" Spacing="12">
            <Grid x:Name="Progress" ColumnSpacing="4" HeightRequest="3" InputTransparent="True" />
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <controls:AvatarView x:Name="AuthorAvatar" Size="38" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" InputTransparent="True">
                    <Label x:Name="AuthorLabel" FontFamily="BodySemibold" FontSize="15" TextColor="White" />
                    <Label x:Name="MetaLabel" FontSize="12" TextColor="#D9FFFFFF" />
                </VerticalStackLayout>
                <ImageButton Grid.Column="2" Source="ic_close.png" Style="{StaticResource IconButton}" BackgroundColor="#33FFFFFF"
                             Clicked="OnClose" SemanticProperties.Description="Close" />
            </Grid>
        </VerticalStackLayout>

        <!-- Footer: feeling, caption, heart bubble and way to the comments -->
        <VerticalStackLayout VerticalOptions="End" Padding="20,0,20,28" Spacing="10">
            <Border x:Name="MoodChip" Style="{StaticResource GlassPill}" InputTransparent="True">
                <Label x:Name="MoodLabel" Style="{StaticResource PillText}" TextColor="White" />
            </Border>
            <Label x:Name="Caption" FontSize="17" TextColor="White" LineHeight="1.3" InputTransparent="True" />
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,6,0,0">
                <ImageButton x:Name="LikeButton" Source="ic_heart_bubble.png" Clicked="OnLike"
                             WidthRequest="52" HeightRequest="52" CornerRadius="26" Padding="12" BackgroundColor="#33FFFFFF"
                             SemanticProperties.Description="Give heart" />
                <Label x:Name="LikersLabel" Grid.Column="1" FontSize="13" FontFamily="BodyMedium" TextColor="#E6FFFFFF"
                       VerticalOptions="Center" LineBreakMode="TailTruncation" InputTransparent="True" />
                <Button x:Name="CommentButton" Grid.Column="2" ImageSource="ic_comment_white.png" ContentLayout="Left,8" Clicked="OnComments"
                        Background="#33FFFFFF" TextColor="White" FontFamily="BodySemibold" FontSize="14"
                        CornerRadius="26" HeightRequest="52" Padding="18,0" BorderWidth="0"
                        SemanticProperties.Hint="Opens the highlight with its comments" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
