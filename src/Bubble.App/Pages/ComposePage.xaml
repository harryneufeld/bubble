<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Bubble.App.Pages.ComposePage"
             Shell.TabBarIsVisible="False"
             Title="Share highlight">
    <Grid Style="{StaticResource Column}" RowDefinitions="*,Auto" Padding="16,8,16,16">
        <ScrollView>
            <VerticalStackLayout Spacing="14" Padding="0,0,0,12">
                <Label Text="How are you feeling?" Style="{StaticResource TitleText}" />
                <Label x:Name="FeelingHint" Style="{StaticResource CaptionText}" Text="Tap an emoji that fits your day." />

                <!-- Feeling: one emoji, optional -->
                <FlexLayout x:Name="FeelingGrid" Wrap="Wrap" JustifyContent="Start" />

                <Border Style="{StaticResource Field}" Padding="12,6">
                    <Editor x:Name="TextEditor" Placeholder="What was special today?" AutoSize="TextChanges" MaxLength="1000"
                            MinimumHeightRequest="120" SemanticProperties.Description="Your highlight" />
                </Border>

                <Border x:Name="PreviewFrame" Style="{StaticResource Photo}" IsVisible="False">
                    <Image x:Name="Preview" Aspect="AspectFill" HeightRequest="320" SemanticProperties.Description="Chosen photo" />
                </Border>
                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="12">
                    <Button x:Name="PhotoButton" Text="Add photo" ImageSource="ic_camera.png" Clicked="OnPickPhoto" Style="{StaticResource SecondaryButton}" />
                    <Button x:Name="DesignButton" Grid.Column="1" Text="Design" ImageSource="ic_edit.png" Clicked="OnDesign" Style="{StaticResource SecondaryButton}"
                            SemanticProperties.Hint="Opens the editor for photos, text and shapes" />
                    <Button x:Name="RemovePhotoButton" Grid.Column="2" Text="Remove" Clicked="OnRemovePhoto" IsVisible="False" Style="{StaticResource GhostButton}" />
                </Grid>
                <Label Text="Location and camera data are removed." Style="{StaticResource CaptionText}" />

                <!-- Choose bubble -->
                <Label Text="Share in" Style="{StaticResource SectionText}" Margin="0,8,0,0" />
                <FlexLayout x:Name="BubbleChips" Wrap="Wrap" JustifyContent="Start" />

                <Border Style="{StaticResource InfoBar}">
                    <Label x:Name="LifetimeLabel" Style="{StaticResource SmallText}" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1">
            <Button x:Name="ShareButton" Text="Share" Clicked="OnShare" />
            <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="{Binding IsRunning, Source={x:Reference Busy}}"
                               Color="White" HorizontalOptions="End" Margin="0,0,20,0" HeightRequest="24" WidthRequest="24" />
        </Grid>
    </Grid>
</ContentPage>
