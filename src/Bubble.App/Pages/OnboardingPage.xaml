<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Bubble.App.Controls"
             x:Class="Bubble.App.Pages.OnboardingPage"
             Shell.PresentationMode="ModalNotAnimated"
             Shell.NavBarIsVisible="False"
             Title="Welcome">
    <Grid>
        <!-- Decoration: iridescent bubbles in the background -->
        <Ellipse WidthRequest="340" HeightRequest="340" Opacity="0.55" HorizontalOptions="End" VerticalOptions="Start" Margin="0,-90,-120,0"
                 Fill="{StaticResource BubbleGradient}" InputTransparent="True" />
        <Ellipse WidthRequest="180" HeightRequest="180" Opacity="0.35" HorizontalOptions="Start" VerticalOptions="Start" Margin="-60,210,0,0"
                 Fill="{StaticResource CtaGradient}" InputTransparent="True" />
        <Ellipse WidthRequest="70" HeightRequest="70" Opacity="0.5" HorizontalOptions="End" VerticalOptions="Start" Margin="0,280,48,0"
                 Fill="{StaticResource BubbleGradient}" InputTransparent="True" />
        <BoxView InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#330B0A10" Offset="0" />
                    <GradientStop Color="#FF0B0A10" Offset="0.55" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <ScrollView>
            <Grid Style="{StaticResource Column}" Padding="24,56,24,32">

                <!-- Step 1: Welcome -->
                <VerticalStackLayout x:Name="WelcomeStep" Spacing="16" VerticalOptions="End" Margin="0,180,0,0">
                    <Label Text="bubble" Style="{StaticResource Wordmark}" FontSize="44" />
                    <Label Text="Your day.&#10;Your people." Style="{StaticResource HeroText}" FontSize="44" />
                    <Label Style="{StaticResource SoftText}" FontSize="17"
                           Text="Share a highlight every day with your closest people. End-to-end encrypted, no email and no phone number." />
                    <Button Text="Get started" Clicked="OnBegin" Margin="0,24,0,0" />
                    <Button Text="I already have an account" Clicked="OnShowRestore" Style="{StaticResource GhostButton}" />
                </VerticalStackLayout>

                <!-- Step 2: Profile -->
                <VerticalStackLayout x:Name="ProfileStep" Spacing="14" IsVisible="False">
                    <Label Text="Who are you?" Style="{StaticResource HeroText}" />
                    <Label Style="{StaticResource SoftText}" Text="This is how your bubbles see you. Your profile only goes, encrypted, to people in your bubbles." />

                    <Grid HorizontalOptions="Center" Margin="0,16">
                        <controls:AvatarView x:Name="AvatarPreview" Size="132" Ring="New" ShowPlus="True" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPickAvatar" />
                        </Grid.GestureRecognizers>
                        <SemanticProperties.Description>Choose profile picture</SemanticProperties.Description>
                    </Grid>
                    <Label Text="Tap the picture to choose a photo" Style="{StaticResource CaptionText}" HorizontalTextAlignment="Center" Margin="0,-6,0,8" />

                    <Label Text="Name" Style="{StaticResource SectionText}" />
                    <Border Style="{StaticResource Field}">
                        <Entry x:Name="NameEntry" Placeholder="What do your people call you?" MaxLength="40" ReturnType="Next"
                               TextChanged="OnNameChanged" SemanticProperties.Description="Your name" />
                    </Border>
                    <Label Text="About you (optional)" Style="{StaticResource SectionText}" Margin="0,6,0,0" />
                    <Border Style="{StaticResource Field}">
                        <Entry x:Name="BioEntry" Placeholder="e.g. Coffee first, then talk" MaxLength="80" ReturnType="Done"
                               SemanticProperties.Description="About you" />
                    </Border>

                    <Button x:Name="CreateButton" Text="Create profile" Clicked="OnCreate" Margin="0,16,0,0" />
                    <Grid ColumnDefinitions="*,Auto" Margin="4,0">
                        <Label x:Name="ServerLabel" Style="{StaticResource CaptionText}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Change server" Clicked="OnChangeServer" Style="{StaticResource GhostButton}" FontSize="13" />
                    </Grid>
                </VerticalStackLayout>

                <!-- Restore -->
                <VerticalStackLayout x:Name="RestoreStep" Spacing="14" IsVisible="False">
                    <Label Text="Welcome back" Style="{StaticResource HeroText}" />
                    <Label Style="{StaticResource SoftText}" Text="Enter your backup code. You can find it in your password manager, for example. Your backup lives on the server you used before, so pick that one." />
                    <Border Style="{StaticResource Field}" Margin="0,12,0,0">
                        <Entry x:Name="CodeEntry" Placeholder="XXXXX-XXXXX-XXXXX-XXXXX-XXXXX" FontFamily="{StaticResource MonoFont}" FontSize="15"
                               IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" SemanticProperties.Description="Backup code" />
                    </Border>
                    <Button x:Name="RestoreButton" Text="Restore" Clicked="OnRestore" Margin="0,12,0,0" />
                    <Grid ColumnDefinitions="*,Auto" Margin="4,0">
                        <Label x:Name="RestoreServerLabel" Style="{StaticResource CaptionText}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Change server" Clicked="OnChangeServer" Style="{StaticResource GhostButton}" FontSize="13" />
                    </Grid>
                    <Button Text="Back" Clicked="OnShowWelcome" Style="{StaticResource GhostButton}" />
                </VerticalStackLayout>

                <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="{Binding IsRunning, Source={x:Reference Busy}}"
                                   VerticalOptions="End" HorizontalOptions="Center" />
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
