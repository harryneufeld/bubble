<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Bubble.App.Pages.OnboardingPage"
             Shell.PresentationMode="ModalNotAnimated"
             Shell.NavBarIsVisible="False"
             Title="Willkommen">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource Column}" Padding="16,48,16,32" Spacing="12">
            <Label Text="🫧" FontSize="44" />
            <Label Text="Willkommen bei Bubble" Style="{StaticResource DisplayText}" />
            <Label Style="{StaticResource SoftText}"
                   Text="Teile jeden Tag ein Highlight mit deinen Leuten. Alles ist Ende-zu-Ende-verschlüsselt, und du brauchst weder E-Mail noch Telefonnummer." />

            <Label Text="Wie sollen dich deine Bubbles nennen?" Style="{StaticResource HeadingText}" Margin="0,24,0,0" />
            <Border Style="{StaticResource Field}">
                <Entry x:Name="NameEntry" Placeholder="Dein Name" ReturnType="Done" Completed="OnStart"
                       SemanticProperties.Description="Dein Name" />
            </Border>
            <Button x:Name="StartButton" Text="Los geht's" Clicked="OnStart" Style="{StaticResource PrimaryButton}" />

            <BoxView Style="{StaticResource Divider}" Margin="0,24" />

            <Label Text="Du hast schon einen Account?" Style="{StaticResource HeadingText}" />
            <Label Style="{StaticResource SmallText}"
                   Text="Gib deinen Backup-Code ein. Du findest ihn zum Beispiel in deinem Passwortmanager." />
            <Border Style="{StaticResource Field}">
                <Entry x:Name="CodeEntry" Placeholder="XXXXX-XXXXX-XXXXX-XXXXX-XXXXX"
                       FontFamily="{StaticResource MonoFont}" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                       SemanticProperties.Description="Backup-Code" />
            </Border>
            <Button x:Name="RestoreButton" Text="Wiederherstellen" Clicked="OnRestore" Style="{StaticResource SecondaryButton}" />
            <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="{Binding IsRunning, Source={x:Reference Busy}}" />

            <BoxView Style="{StaticResource Divider}" Margin="0,24" />

            <Label Text="Server" Style="{StaticResource HeadingText}" />
            <Label Style="{StaticResource SmallText}"
                   Text="Adresse des Relays, z. B. eines Rechners in deinem Netzwerk. Der Relay speichert nur verschlüsselte Daten." />
            <Border Style="{StaticResource Field}">
                <Entry x:Name="ServerEntry" Placeholder="192.168.1.20:5080" Keyboard="Url"
                       SemanticProperties.Description="Server-Adresse" />
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
