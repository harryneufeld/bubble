<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Bubble.App.Pages.BackupPage"
             Shell.TabBarIsVisible="False"
             Title="Backup">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource Column}" Padding="20,8,20,32" Spacing="14">
            <Label Text="Continue on a new device" Style="{StaticResource TitleText}" />
            <Label Style="{StaticResource SoftText}"
                   Text="Your keys only live on this device. A backup code brings them to a new device. The server only stores the backup encrypted and cannot open it without your code." />

            <Border Style="{StaticResource InfoBar}">
                <Label x:Name="StatusLabel" Style="{StaticResource SmallText}" />
            </Border>

            <Border x:Name="CodeBox" IsVisible="False" Style="{StaticResource SecretBox}" Margin="0,8,0,0">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Your backup code" Style="{StaticResource SectionText}" HorizontalTextAlignment="Center" />
                    <Label x:Name="CodeLabel" Style="{StaticResource CodeText}" FontSize="20" LineBreakMode="WordWrap" />
                    <Button Text="Copy code" ImageSource="ic_copy.png" Clicked="OnCopy" Style="{StaticResource SecondaryButton}" />
                    <Label Style="{StaticResource SmallText}"
                           Text="Save the code in your password manager now, e.g. Bitwarden, 1Password, Apple Passwords or Google Password Manager. It is only shown this once. Without it nobody can open your backup, not even you." />
                </VerticalStackLayout>
            </Border>

            <Button x:Name="CreateButton" Clicked="OnCreate" Margin="0,8,0,0" />
            <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="{Binding IsRunning, Source={x:Reference Busy}}" />

            <BoxView Style="{StaticResource Divider}" Margin="0,16" />

            <Label Text="Passkey (soon)" Style="{StaticResource HeadingText}" />
            <Label Style="{StaticResource CaptionText}" FontSize="14"
                   Text="Later you will also unlock the backup with a passkey, i.e. with Face ID or a fingerprint, synced through your password manager. The backup code stays as an alternative." />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
