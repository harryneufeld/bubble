<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Bubble.App.Pages.AboutPage"
             Shell.TabBarIsVisible="False"
             Title="About this app">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource Column}" Padding="20,12,20,32" Spacing="14">
            <VerticalStackLayout Spacing="4" Margin="0,0,0,6">
                <Ellipse WidthRequest="64" HeightRequest="64" Fill="{StaticResource BubbleGradient}" HorizontalOptions="Center" Margin="0,0,0,6" />
                <Label Text="Bubble" Style="{StaticResource TitleText}" FontSize="20" HorizontalTextAlignment="Center" />
                <Label x:Name="VersionLabel" Style="{StaticResource SmallText}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}" Padding="4">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="14,14"
                          SemanticProperties.Description="Bubble website" SemanticProperties.Hint="Opens the browser">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnBubbleWebsite" /></Grid.GestureRecognizers>
                        <Image Source="ic_link.png" WidthRequest="22" HeightRequest="22" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Website" Style="{StaticResource HeadingText}" FontSize="16" />
                            <Label Text="bubble-social.org" Style="{StaticResource CaptionText}" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" Source="ic_chevron.png" WidthRequest="18" HeightRequest="18" Opacity="0.6" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" Margin="14,0" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="14,14"
                          SemanticProperties.Description="Bubble on GitHub" SemanticProperties.Hint="Opens the browser">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnGitHub" /></Grid.GestureRecognizers>
                        <Image Source="ic_link.png" WidthRequest="22" HeightRequest="22" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Source code on GitHub" Style="{StaticResource HeadingText}" FontSize="16" />
                            <Label Text="github.com/harryneufeld/bubble" Style="{StaticResource CaptionText}" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" Source="ic_chevron.png" WidthRequest="18" HeightRequest="18" Opacity="0.6" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="Credits" Style="{StaticResource SectionText}" Margin="0,8,0,0" />
            <Border Style="{StaticResource Card}" Padding="18,14">
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout Spacing="2" SemanticProperties.Description="Made by Harry Neufeld" SemanticProperties.Hint="Opens the browser">
                        <VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnAuthor" /></VerticalStackLayout.GestureRecognizers>
                        <Label Text="Made by" Style="{StaticResource CaptionText}" />
                        <Label Text="Harry Neufeld" Style="{StaticResource HeadingText}" FontSize="15" TextColor="{StaticResource Accent}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Built with" Style="{StaticResource CaptionText}" />
                        <Label Text=".NET MAUI, SkiaSharp, QRCoder, ZXing.Net.MAUI" FontSize="14" LineHeight="1.3" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Fonts" Style="{StaticResource CaptionText}" />
                        <Label Text="Inter, Fraunces, Bebas Neue, Caveat Brush, DM Serif Display, Pacifico, Space Mono" FontSize="14" LineHeight="1.3" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Style="{StaticResource CaptionText}" Margin="4,8,4,0" HorizontalTextAlignment="Center"
                   Text="Bubble only stores encrypted data. Your key lives on this device – no account, no phone number." />
            <Label Text="© 2026 Harry Neufeld" Style="{StaticResource CaptionText}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
