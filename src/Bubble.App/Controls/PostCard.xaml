<?xml version="1.0" encoding="utf-8" ?>
<!-- Post-Karte: Kopf mit Avatar, Foto randlos (oder Text auf Verlauf), Lebensdauer als Glas-Pille -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Bubble.App.Controls"
             xmlns:pages="clr-namespace:Bubble.App.Pages"
             x:Class="Bubble.App.Controls.PostCard"
             x:DataType="pages:PostItem">
    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16">
        <VerticalStackLayout>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,12">
                <controls:AvatarView Size="40" Image="{Binding AuthorAvatar}" Name="{Binding AuthorName}" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                    <Label Text="{Binding Author}" Style="{StaticResource HeadingText}" FontSize="15" />
                    <Label Text="{Binding Meta}" Style="{StaticResource CaptionText}" />
                </VerticalStackLayout>
                <Border Grid.Column="2" Style="{StaticResource ChipTop}" IsVisible="{Binding IsTop}">
                    <Label Text="{Binding Mood}" Style="{StaticResource ChipTopText}" />
                </Border>
                <Border Grid.Column="2" Style="{StaticResource ChipFlop}" IsVisible="{Binding IsFlop}">
                    <Label Text="{Binding Mood}" Style="{StaticResource ChipFlopText}" />
                </Border>
            </Grid>

            <!-- Foto -->
            <Grid IsVisible="{Binding HasImage}" HeightRequest="460">
                <Image Source="{Binding Image}" Aspect="AspectFill" SemanticProperties.Description="{Binding ImageDescription}" />
                <Border Style="{StaticResource GlassPill}" HorizontalOptions="End" VerticalOptions="Start" Margin="12">
                    <Label Text="{Binding Remaining}" Style="{StaticResource PillText}" TextColor="White" />
                </Border>
            </Grid>

            <!-- Nur Text: groß auf leuchtendem Verlauf -->
            <Grid IsVisible="{Binding IsTextOnly}" MinimumHeightRequest="260" Background="{Binding TextBackground}">
                <Label Text="{Binding Text}" FontFamily="BodyBold" FontSize="26" LineHeight="1.15" TextColor="White"
                       HorizontalTextAlignment="Center" VerticalOptions="Center" Margin="28,56" />
                <Border Style="{StaticResource GlassPill}" HorizontalOptions="End" VerticalOptions="Start" Margin="12">
                    <Label Text="{Binding Remaining}" Style="{StaticResource PillText}" TextColor="White" />
                </Border>
            </Grid>

            <Label Text="{Binding Text}" IsVisible="{Binding HasCaption}" Padding="16,12,16,16" LineHeight="1.3" />
        </VerticalStackLayout>
    </Border>
</ContentView>
